# Copy the variables you need into:
# %LOCALAPPDATA%\Microvid\.env
# or another directory referenced by MICROVID_CONFIG_DIR.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional legacy providers
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional runtime overrides
# MICROVID_CONFIG_DIR=C:\path\to\Microvid
# MICROVID_FIGURE_MODEL=gemini-3.8-flash
# MICROVID_SLIDE_MODEL=gemini-3.1-pro-preview
# MICROVID_NARRATION_MODEL=gemini-3.1-pro-preview
# MICROVID_FFMPEG=C:\path\to\ffmpeg.exe
# MICROVID_FFMPEG_TIMEOUT_SECONDS=300

# Optional common LLM override for figure, slide, and narration stages
# MICROGEN_LLM_MODEL=gemini-3.1-pro-preview

# Optional multi-PC Gemini serialization (all workers must use the same synced directory)
# MICROGEN_GEMINI_LANE_DIR=G:\My Drive\MicroGen_AI\coordination\gemini_lane
# MICROGEN_GEMINI_LANE_SETTLE_SECONDS=20
# MICROGEN_GEMINI_LANE_CLAIM_GRACE_SECONDS=8
# MICROGEN_GEMINI_LANE_COOLDOWN_SECONDS=10
# MICROGEN_GEMINI_LANE_STALE_SECONDS=3600
# MICROGEN_GEMINI_LANE_MOUNT_WAIT_SECONDS=300
# MICROGEN_GEMINI_FIGURE_COOLDOWN_SECONDS=2
# MICROGEN_GEMINI_BILLING_RECHECK_SECONDS=1800
# MICROGEN_GEMINI_MAX_RETRIES=6
# MICROGEN_GEMINI_BACKOFF_BASE_SECONDS=15
# MICROGEN_GEMINI_BACKOFF_MAX_SECONDS=180
