# Copy the variables you need into:
# %LOCALAPPDATA%\Microvid\.env
# or another directory referenced by MICROVID_CONFIG_DIR.

GEMINI_API_KEY_1=your_primary_gemini_api_key_here
# GEMINI_API_KEY_2=your_secondary_gemini_api_key_here
# Add GEMINI_API_KEY_3, GEMINI_API_KEY_4, ... as needed.
# Legacy GEMINI_API_KEY remains supported for backward compatibility.

# Optional legacy providers
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional runtime overrides
# MICROVID_CONFIG_DIR=C:\path\to\Microvid
# MICROVID_FIGURE_MODEL=gemini-3.8-flash
# MICROVID_SLIDE_MODEL=gemini-3.8-flash
# MICROVID_NARRATION_MODEL=gemini-3.8-flash
# MICROVID_FFMPEG=C:\path\to\ffmpeg.exe
# MICROVID_FFMPEG_TIMEOUT_SECONDS=300

# Optional common LLM override for figure, slide, and narration stages
# MICROGEN_LLM_MODEL=gemini-3.8-flash

# Optional multi-PC Gemini serialization (all workers must use the same synced directory)
# MICROGEN_GEMINI_LANE_DIR=G:\My Drive\MicroGen_AI\coordination\gemini_lane
# MICROGEN_GEMINI_LANE_SETTLE_SECONDS=20
# MICROGEN_GEMINI_LANE_CLAIM_GRACE_SECONDS=8
# MICROGEN_GEMINI_LANE_COOLDOWN_SECONDS=10
# MICROGEN_GEMINI_LANE_STALE_SECONDS=3600
# MICROGEN_GEMINI_LANE_MOUNT_WAIT_SECONDS=300
# MICROGEN_GEMINI_FIGURE_COOLDOWN_SECONDS=2
# MICROGEN_GEMINI_BILLING_RECHECK_SECONDS=1800
# MICROGEN_GEMINI_MAX_RETRIES=6
# MICROGEN_GEMINI_BACKOFF_BASE_SECONDS=15
# MICROGEN_GEMINI_BACKOFF_MAX_SECONDS=180

# Owner amendment 2026-10-30: Cloud TTS may be used for diagnostic troubleshooting,
# but is NOT the formal TTS default. New formal TTS requests refuse to synthesize
# until a formally approved provider is explicitly selected. Do NOT put actual
# credentials or paid-account details in this sample.
# MICROGEN_FORMAL_TTS_PROVIDER=unconfigured
# Exceptional, explicitly approved formal Cloud run only:
# MICROGEN_FORMAL_TTS_PROVIDER=google_cloud
# Provider troubleshooting (single <=500-character attempt, isolated output):
# python microgen_cloud_tts_diagnostic.py --text "At c. Next." --new-diagnostic-directory "C:\path\to\diagnostic_trial_001" --confirm-chargeable-diagnostic
# --confirm-chargeable-diagnostic records explicit operational intent; this
# diagnostic permission is granted by the owner and does not approve formal TTS.
